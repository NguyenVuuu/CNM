<!DOCTYPE html>
<html>

<head>
    <title>Product Manager</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="bg-light">

    <div class="container mt-5">

        <h2 class="mb-4 text-center">Product Management</h2>

        <div class="d-flex justify-content-between mb-3">

            <form action="/search" class="d-flex">

                <input class="form-control me-2" name="keyword" placeholder="Search product">

                <button class="btn btn-primary">Search</button>

            </form>

            <a href="/add" class="btn btn-success">Add Product</a>

        </div>

        <!-- Nếu không có sản phẩm -->

        <% if(products.length === 0){ %>

            <div class="text-center mt-5">

                <h3 class="text-danger fw-bold">
                    🔍 Không thấy sản phẩm "
                    <%= typeof keyword !== 'undefined' ? keyword : '' %>"
                </h3>

            </div>

            <% } else { %>

                <table class="table table-bordered table-hover text-center align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Image</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% products.forEach(p => { %>

                            <tr>

                                <td>
                                    <%= p.productId %>
                                </td>

                                <td>
                                    <%= p.name %>
                                </td>

                                <td>
                                    <!-- <img src="<%= p.image %>" width="80" class="rounded"> -->
                                    <img src="<%= p.image || '/no-image.png' %>" width="80">
                                </td>

                                <td>$
                                    <%= p.price %>
                                </td>

                                <td>
                                    <%= p.quantity %>
                                </td>

                                <td>

                                    <a href="/edit/<%= p.productId %>" class="btn btn-warning btn-sm">Edit</a>

                                    <a href="/delete/<%= p.productId %>" class="btn btn-danger btn-sm" onclick="return confirm('Delete this product?')">
Delete
</a>

                                </td>

                            </tr>

                            <% }) %>

                    </tbody>

                </table>

                <% } %>

    </div>

</body>

</html>