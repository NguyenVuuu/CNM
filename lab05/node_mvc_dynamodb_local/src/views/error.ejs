<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lỗi - <%= message %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .error-container {
            max-width: 600px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            padding: 40px;
            text-align: center;
        }

        .error-icon {
            font-size: 80px;
            margin-bottom: 20px;
        }

        h1 {
            color: #e74c3c;
            margin-bottom: 20px;
        }

        .error-message {
            color: #555;
            font-size: 18px;
            margin-bottom: 30px;
        }

        .error-details {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 5px;
            text-align: left;
            margin-bottom: 30px;
            font-family: monospace;
            font-size: 12px;
            color: #666;
            max-height: 300px;
            overflow-y: auto;
        }

        .btn {
            display: inline-block;
            padding: 12px 30px;
            background: #667eea;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            transition: background 0.3s;
        }

        .btn:hover {
            background: #5568d3;
        }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="error-icon">⚠️</div>
        <h1>Đã xảy ra lỗi!</h1>
        <div class="error-message">
            <%= message %>
        </div>

        <% if (error && error.stack) { %>
            <div class="error-details">
                <strong>Chi tiết lỗi:</strong><br>
                <%= error.stack %>
            </div>
        <% } %>

        <a href="/products" class="btn">↩️ Quay về trang chủ</a>
    </div>
</body>
</html>
